# Copy to .env and fill in values. Never commit real secrets.
# Local `supabase start` prints SUPABASE_URL and keys to the terminal.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mindee Invoice OCR — required for extract
MINDEE_API_KEY=
# Required when using a Mindee API v2 key (from Mindee dashboard → model id)
MINDEE_MODEL_ID=

# Gemini vision fallback (replaces OpenAI) — free Flash tier, not 2.5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Per-company OCR→Gemini threshold lives in
# company_config.extraction_confidence_threshold (default 0.8).

# OpenAI — read by the triage function only (classifying inbound documents).
# triage throws without the key; the other two have defaults.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TRIAGE_LLM_MODEL=gpt-4o-mini

# Zoho Books — hosted Edge Functions read these from Supabase secrets
# (per environment), NOT from VITE_ / NEXT_PUBLIC_ and never from git.
# Set them with the CLI after `supabase link`:
#   npx supabase secrets set ZOHO_CLIENT_ID=... ZOHO_CLIENT_SECRET=...
# Local `npm run functions:serve -- --env-file .env` still uses this file.
# Do not add VITE_ZOHO_* or NEXT_PUBLIC_ZOHO_* — the browser must never
# see client secret / refresh / access tokens.
#
# The OAuth *application* is one registration shared by every company, so
# these two stay in the environment:
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_API_BASE_URL=https://www.zohoapis.com/books/v3

# Each COMPANY's own Zoho organisation and refresh token are held per
# company in the zoho_connections table, with the refresh token in Supabase
# Vault — never in this file. Connect a company with:
#   node scripts/zoho-connect.mjs
# (ZOHO_REFRESH_TOKEN, ZOHO_ORGANIZATION_ID, ZOHO_ACCESS_TOKEN and
# ZOHO_ACCOUNTS_URL used to live here. Nothing reads them now; setting them
# has no effect. Delete them from any .env you already have.)

# Account defaults now come from per-vendor rules (vendor_account_rules
# table, managed in the review UI) — there is no global default account.
# ZOHO_EXPENSE_CATEGORY / ZOHO_DEFAULT_ACCOUNT_ID env values are no longer
# read by zoho-push; expense_category still works as a per-request hint.
ZOHO_DEFAULT_VENDOR_ID=
# Fallback bank/cash account for post_as=expense when the UI sends none
ZOHO_PAID_THROUGH_ACCOUNT_ID=
# Optional JSON caches if not passed in the request body / live fetch fails
ZOHO_VENDORS_JSON=
ZOHO_ACCOUNTS_JSON=

# Inbound email (Mailgun) — unique address per company:
#   {company-slug}-{random}@INBOUND_EMAIL_DOMAIN
# Point MX for INBOUND_EMAIL_DOMAIN at Mailgun, route to:
#   POST {SUPABASE_URL}/functions/v1/inbound-email
INBOUND_EMAIL_DOMAIN=in.ourapp.com
MAILGUN_SIGNING_KEY=
#
# MAILGUN_WEBHOOK_SKIP_VERIFY=true turns OFF the check that an inbound
# message really came from Mailgun. With it on, anyone who learns a
# company's inbound address can post invoices into that company's books.
# LEAVE IT EMPTY. It exists for scripts/inbound-email-accuracy.mjs, which
# has no real Mailgun signature to present — set it in that run only, e.g.
#   MAILGUN_WEBHOOK_SKIP_VERIFY=true node scripts/inbound-email-accuracy.mjs
# Never set it in a hosted environment, and never commit it as true.
MAILGUN_WEBHOOK_SKIP_VERIFY=

# Demo seed (scripts/demo/reset-demo.mjs) — a LOCAL Auth user who is a
# member of the demo company. Not used by the app itself.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
