# Copy to .env and fill in values. Never commit real secrets.
# Local `supabase start` prints SUPABASE_URL and keys to the terminal.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mindee Invoice OCR — required for extract
MINDEE_API_KEY=
# Required when using a Mindee API v2 key (from Mindee dashboard → model id)
MINDEE_MODEL_ID=

# Gemini vision fallback (replaces OpenAI) — free Flash tier, not 2.5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Per-company OCR→Gemini threshold lives in
# company_config.extraction_confidence_threshold (default 0.8).

# Zoho Books + Anthropic — hosted Edge Functions read these from
# Supabase secrets (per environment), NOT from VITE_ / NEXT_PUBLIC_
# and never from git. Set them with the CLI after `supabase link`:
#   npx supabase secrets set ZOHO_CLIENT_ID=... ZOHO_CLIENT_SECRET=...
#   npx supabase secrets set ZOHO_REFRESH_TOKEN=... ANTHROPIC_API_KEY=...
# Local `npm run functions:serve -- --env-file .env` still uses this file.
# Do not add VITE_ZOHO_* or NEXT_PUBLIC_ZOHO_* — the browser must never
# see client secret / refresh / access tokens.
#
# Zoho Books push — point these at your SANDBOX organization
# (Settings → Organization / Developer → API; use sandbox org id)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCESS_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com/books/v3
# Account defaults now come from per-vendor rules (vendor_account_rules
# table, managed in the review UI) — there is no global default account.
# ZOHO_EXPENSE_CATEGORY / ZOHO_DEFAULT_ACCOUNT_ID env values are no longer
# read by zoho-push; expense_category still works as a per-request hint.
ZOHO_DEFAULT_VENDOR_ID=
# Create vendor contact in sandbox when name is new (default true)
# Fallback bank/cash account for post_as=expense when the UI sends none
ZOHO_PAID_THROUGH_ACCOUNT_ID=
# Optional JSON caches if not passed in the request body / live fetch fails
ZOHO_VENDORS_JSON=
ZOHO_ACCOUNTS_JSON=

# Inbound email (Mailgun) — unique address per company:
#   {company-slug}-{random}@INBOUND_EMAIL_DOMAIN
# Point MX for INBOUND_EMAIL_DOMAIN at Mailgun, route to:
#   POST {SUPABASE_URL}/functions/v1/inbound-email
INBOUND_EMAIL_DOMAIN=in.ourapp.com
MAILGUN_SIGNING_KEY=
# Local accuracy tests: skip HMAC (scripts/inbound-email-accuracy.mjs)
MAILGUN_WEBHOOK_SKIP_VERIFY=true
