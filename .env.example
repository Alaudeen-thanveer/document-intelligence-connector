# Copy to .env and fill in values. Never commit real secrets.
# Local `supabase start` prints SUPABASE_URL and keys to the terminal.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Triage + extract LLM fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TRIAGE_LLM_MODEL=gpt-4o-mini
EXTRACT_LLM_MODEL=gpt-4o

# Mindee Invoice OCR (Step 3)
MINDEE_API_KEY=

# Zoho Books push (Step 7) — never hardcode these in source
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCESS_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com/books/v3
# Optional JSON caches if not passed in the request body
ZOHO_VENDORS_JSON=
ZOHO_ACCOUNTS_JSON=
